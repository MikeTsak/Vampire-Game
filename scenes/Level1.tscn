[sub_resource type="Shader" id="Shader_dw26h"]
code = "
shader_type sky;
void sky() {
\tCOLOR = vec3(0.0);
\tfloat n = fract(sin(dot(EYEDIR, vec3(12.9898, 78.233, 45.164))) * 43758.5453);
\tif (n > 0.998) {
\t\tCOLOR = vec3(1.0);
\t}
}
"
size = Vector3(200, 20, 1)
